# Cloudflare / GH Pages headers — documented here, applied via Cloudflare Rules / _headers on Pages
# GH Pages ignores this file — Cloudflare Pages and docs use it.
# Apply via Cloudflare Transform Rules or Pages _headers if migrating.

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/*.png
  Cache-Control: public, max-age=86400

/sitemap.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=3600

/feed.xml
  Content-Type: application/rss+xml
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/tools.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: origin-when-cross-origin
